{
  "name": "@blockforge/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@blockforge/source src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc-rs -p tsconfig.build.json",
    "typecheck": "tsc-rs -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:generate": "node --conditions=@blockforge/source ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --conditions=@blockforge/source src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@blockforge/contracts": "workspace:*",
    "@blockforge/eggs": "workspace:*",
    "@blockforge/minecraft": "workspace:*",
    "@blockforge/velocity": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@node-rs/argon2": "^2.2.2",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
