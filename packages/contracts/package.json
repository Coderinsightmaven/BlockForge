{
  "name": "@blockforge/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Shared domain types, zod schemas, REST DTOs, realtime frames and the node-agent protocol.",
  "exports": {
    ".": {
      "@blockforge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
