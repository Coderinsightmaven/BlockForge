{
  "name": "@blockforge/eggs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@blockforge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc-rs -p tsconfig.build.json",
    "typecheck": "tsc-rs -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@blockforge/contracts": "workspace:*",
    "@blockforge/minecraft": "workspace:*",
    "re2js": "2.8.6",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "description": "Pterodactyl/Pelican egg import, variable rules, startup resolution and config-file parsers (pure TS)."
}
